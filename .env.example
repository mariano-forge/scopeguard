# Copy to .env.local and fill in.

# Which database to use: "local" (Docker) or "remote" (Supabase, later Azure).
DATABASE_TARGET=local

# Postgres from docker-compose.yml (npm run db:up).
DATABASE_URL_LOCAL=postgres://kora:kora@127.0.0.1:5432/kora

# Supabase: Connect > "Session pooler" (port 5432) for migrations and local use. On Vercel, the
# "Transaction pooler" (port 6543) suits short-lived functions. Choose the pooler of the project's
# region (Frankfurt), next to the functions (vercel.json).
DATABASE_URL_REMOTE=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Recommended: CA certificate of the remote server, to verify it besides encrypting.
# Supabase: Database > Settings > SSL Configuration > Download certificate, saved in certs/ (ignored by git).
# On Vercel, paste the PEM text itself as the value instead of a path.
# DATABASE_SSL_CA=./certs/supabase-ca.crt

# Sign-in (Better Auth). Secret: at least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public address of the app (used for links and the Google redirect).
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continuer avec Google". Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application), authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Continuer avec Microsoft". Microsoft Entra admin center > App registrations > New
# registration (accounts in any organizational directory and personal Microsoft accounts), redirect URI
# (Web): <BETTER_AUTH_URL>/api/auth/callback/microsoft; then Certificates & secrets > New client secret.
# Token configuration > Add optional claim > ID: verified_primary_email and verified_secondary_email, so
# that addresses on a directory's verified domain sign in directly (others confirm by mailed link first).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (work and personal accounts) when empty; a tenant ID limits sign-in to one organization.
MICROSOFT_TENANT_ID=

# E-mails (review invitations, access codes). Resend: https://resend.com (free tier).
# Without them, mails are printed in the server console in development.
RESEND_API_KEY=
MAIL_FROM="Kora <revue@votre-domaine.fr>"
# "console": never send, print instead (tests, demos), even with a Resend key. Never set online.
# MAIL_TRANSPORT=console
# With MAIL_TRANSPORT=console, also append each mail to this file (the tests read codes and links there).
# MAIL_OUTBOX=./test-results/outbox.jsonl

# Proxies in front of the app that append the visitor's address to x-forwarded-for: 1 behind
# Azure Front Door or Vercel, 0 locally. Used for the IP addresses shown in proofs.
TRUSTED_PROXY_HOPS=0

# File storage (Azure Blob): "local" (Azurite, from docker-compose.yml) or "remote" (Azure account).
STORAGE_TARGET=local
# Azurite's public development account (same values for everyone).
STORAGE_URL_LOCAL=http://127.0.0.1:10000/devstoreaccount1
STORAGE_ACCOUNT_LOCAL=devstoreaccount1
STORAGE_KEY_LOCAL=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
# Azure: https://<account>.blob.core.windows.net, the account name and one of its access keys.
STORAGE_URL_REMOTE=
STORAGE_ACCOUNT_REMOTE=
STORAGE_KEY_REMOTE=

# Largest file an agency can import, in MB.
MAX_UPLOAD_MB=50
# Largest video an agency can import as a version, in MB: a film weighs far more than a mock-up.
MAX_VIDEO_UPLOAD_MB=1024
# How long a read-only address of a file lasts, in seconds (a video's: its length and 15 minutes more).
FILE_LINK_SECONDS=300
# Where answers go when no agency member is behind a mail (the sending address has no mailbox).
MAIL_REPLY_TO=
# Where the landing page's demo requests go (MAIL_REPLY_TO when empty; without either, the form answers 503).
DEMO_REQUESTS_TO=
# DEMO_REQUESTS_PER_HOUR=5

# Request limits per person (defaults shown); counted in the database, shared by every instance.
# UPLOADS_PER_HOUR=200
# WRITES_PER_MINUTE=600
# INVITATIONS_PER_HOUR=60
# Code requests on review links, per address (each one says whether an address is invited).
# ACCESS_CODES_PER_HOUR=30
